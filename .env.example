# ── REQUIRED (PRODUCTION) ──
# PostgreSQL connection string (Neon). See docs/DEPLOYMENT.md.
DATABASE_URL=TODO_HUMAN_DATABASE_URL

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=TODO_HUMAN_NEXTAUTH_SECRET

# Public site URL (no trailing slash). Used for OG tags, sitemap, etc.
NEXTAUTH_URL=TODO_HUMAN_NEXTAUTH_URL
NEXT_PUBLIC_SITE_URL=TODO_HUMAN_NEXT_PUBLIC_SITE_URL

# GitHub OAuth app credentials
GITHUB_ID=TODO_HUMAN_GITHUB_ID
GITHUB_SECRET=TODO_HUMAN_GITHUB_SECRET

# Google OAuth app credentials
GOOGLE_CLIENT_ID=TODO_HUMAN_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TODO_HUMAN_GOOGLE_CLIENT_SECRET

# Vercel Blob storage for PDF uploads
BLOB_READ_WRITE_TOKEN=TODO_HUMAN_BLOB_READ_WRITE_TOKEN

# Whop billing
WHOP_API_KEY=TODO_HUMAN_WHOP_API_KEY
WHOP_COMPANY_ID=TODO_HUMAN_WHOP_COMPANY_ID
WHOP_WEBHOOK_SECRET=TODO_HUMAN_WHOP_WEBHOOK_SECRET

# Whop plan ID — canonical two-tier model.
# Only Pro is a paid Whop plan. Starter is free (no Whop plan required).
# Create one monthly Pro plan in the Whop dashboard and paste its id here.
WHOP_PLAN_ID_PRO=TODO_HUMAN_WHOP_PLAN_ID_PRO
# Legacy WHOP_PLAN_ID_AGENCY / WHOP_PLAN_ID_AGENCY_PRO vars are retired.
# Historical subscriptions on those plans still resolve via PlanMapping rows
# and are normalized to Pro at read time.

# ── PRODUCTION-ONLY ──
# Only needed if directUrl is re-enabled in prisma/schema.prisma.
DIRECT_URL=
# One-time use for bootstrap-superadmin.ts, then rotate/remove.
SUPERADMIN_BOOTSTRAP_TOKEN=

# ── OPTIONAL ──
# Rate limiting via Upstash Redis. Degrades to in-memory without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI narrative generation
ZAI_API_KEY=

# ── DEV-ONLY ──
# Entitlement override secret (never set in production)
DEV_ENTITLEMENT_SECRET=
DEBUG_PRISMA=

# QA endpoints (enable with ENABLE_QA_ENDPOINTS=true; requires QA_ORG_ID)
ENABLE_QA_ENDPOINTS=
QA_ORG_ID=

# ── CI-ONLY ──
TEST_DATABASE_URL=
SHADOW_DATABASE_URL=
