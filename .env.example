# ─────────────────────────────────────────────────────────────────────
# Viableo — environment variables
# Copy to .env (dev) or set in Vercel project settings (prod).
# ─────────────────────────────────────────────────────────────────────

# ── Required in ALL environments ───────────────────────────────────────
# PostgreSQL connection string.
#   • Vercel prod: use the POOLED connection string (PgBouncer) so
#     serverless functions don't exhaust the connection pool.
#     Example (Neon): postgresql://user:pass@ep-xxx-pooled.region.aws.neon.tech/db?pgbouncer=true&connection_limit=1
#   • Dev: a SQLite file: URL is permitted (the committed .env uses one).
DATABASE_URL="postgresql://user:password@localhost:5432/viableo"
# Direct (non-pooled) connection for Prisma migrations + introspection.
# Migrations cannot run over PgBouncer (prepared-statement mismatch).
#   • If your provider gives separate pooled + direct URLs (Neon, Supabase),
#     set this to the DIRECT URL.
#   • If you only have ONE URL (local Postgres, pooled-only providers),
#     set DIRECT_URL = DATABASE_URL (same value).
DIRECT_URL="postgresql://user:password@localhost:5432/viableo"
# 32+ random chars. `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me-to-a-32-plus-char-random-string"
# Public URL of the deployment. No trailing slash.
#   • Vercel prod: https://automation-roi-delta.vercel.app (or custom domain)
NEXTAUTH_URL="http://localhost:3000"

# ── Required in PRODUCTION only ───────────────────────────────────────
# GitHub OAuth. Get from https://github.com/settings/developers
GITHUB_ID=""
GITHUB_SECRET=""
# Vercel Blob token (PDF + logo storage). Get from Vercel project > Storage.
BLOB_READ_WRITE_TOKEN=""

# ── Optional ──────────────────────────────────────────────────────────
# Whop webhook signing secret. Get from Whop dashboard > Webhooks.
WHOP_WEBHOOK_SECRET=""
# Upstash Redis (rate limiting — optional, falls back to in-memory).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Dev-only entitlement backdoor guard (for /api/entitlement/set in dev).
DEV_ENTITLEMENT_SECRET=""
# AI SDK (z-ai-web-dev-sdk) — powers /api/ai/estimate, /api/ai/narrative,
# /api/ai/risks (Phase 4 AI features). Leave blank to disable AI routes.
ZAI_API_KEY=""
# Public site URL (for metadata + JSON-LD). Falls back to NEXTAUTH_URL
# if unset. Set to your Vercel domain so OpenGraph/Twitter cards resolve.
NEXT_PUBLIC_SITE_URL=""

# ── Operational ───────────────────────────────────────────────────────
# Set to "1" to enable Prisma query logging in dev.
DEBUG_PRISMA=""
# Next.js sets this automatically; do not set manually.
# NODE_ENV=""
