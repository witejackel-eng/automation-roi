// Viableo — data model.
// PostgreSQL is the production datasource; SQLite .env is kept as a dev fallback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth models (Auth.js v4 compatible) ──────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  memberships Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Multi-tenancy ────────────────────────────────────────────────

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   // 'owner' | 'member'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ── Organization ─────────────────────────────────────────────────

model Organization {
  id            String    @id @default(cuid())
  name          String
  website       String?
  contactEmail  String?
  phone         String?
  logoUrl       String?
  brandColorHex String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects    Project[]
  licenses    License[]
  memberships Membership[]
  shareEvents ShareEvent[]
}

// ── Projects ─────────────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  organizationId String
  clientName     String
  inputs         String // serialized CalculatorInputs (JSON)
  results        String // serialized ScenarioResult x3 (JSON)
  recommendation String   // 'build' | 'consider' | 'dont_build'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      Report[]
  shares       Share[]

  @@index([organizationId])
}

model Report {
  id         String   @id @default(cuid())
  projectId  String
  reportType String // 'client_report' | 'proposal'
  pdfUrl     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  shares Share[]

  @@index([projectId])
}

// ── Sharing & Client Engagement ──────────────────────────────────

model Share {
  id            String    @id @default(cuid())
  shareId       String    @unique // opaque random identifier used in /r/[shareId]
  projectId     String
  reportId      String?   // optional: link to a specific generated report
  decisionState String    @default("sent") // 'sent' | 'viewed' | 'approved' | 'changes_requested'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime? // optional expiry
  revokedAt     DateTime? // set when access is revoked

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approvals  ShareApproval[]
  events     ShareEvent[]

  @@index([shareId])
  @@index([projectId])
}

model ShareApproval {
  id        String   @id @default(cuid())
  shareId   String
  action    String   // 'approve' | 'request_changes'
  name      String?
  email     String?
  comment   String?
  createdAt DateTime @default(now())

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId])
}

model ShareEvent {
  id             String   @id @default(cuid())
  shareId        String
  organizationId String
  eventType      String   // 'view' | 'section_scroll' | 'time_on_page' | 'approval'
  section        String?  // which section was viewed/scrolled
  value          Float?   // scroll depth (0-1), time in seconds, etc.
  metadata       String?  // JSON for extra data
  createdAt      DateTime @default(now())

  share        Share        @relation(fields: [shareId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([organizationId])
  @@index([createdAt])
}

// ── Licensing ────────────────────────────────────────────────────

model License {
  id             String    @id @default(cuid())
  organizationId String
  tier           String    // 'free' | 'pro' | 'agency' | 'agency_pro'
  whopOrderId    String?
  whopEventId    String?   // idempotency key from Whop webhook event
  purchasedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@unique([whopEventId])
}
