// Viableo — data model.
// PostgreSQL is the production datasource; SQLite .env is kept as a dev fallback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"  // Production runs PostgreSQL via Neon.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations + introspection on
  // serverless Postgres (PgBouncer can't run migrations). Falls back to
  // DATABASE_URL when DIRECT_URL is unset. prisma generate (postinstall)
  // resolves this lazily — verified to succeed without DIRECT_URL set.
  directUrl = env("DIRECT_URL")
}

// ── NextAuth models (Auth.js v4 compatible) ──────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // System-level role. 'USER' (default) | 'SUPERADMIN' (founder/operator).
  // Threaded through the NextAuth jwt()/session() callbacks alongside the
  // existing organizationId/role fields — see src/lib/auth.ts.
  systemRole    String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  memberships Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Multi-tenancy ────────────────────────────────────────────────

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   // 'owner' | 'member'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ── Organization ─────────────────────────────────────────────────

model Organization {
  id            String    @id @default(cuid())
  name          String
  website       String?
  contactEmail  String?
  phone         String?
  logoUrl       String?
  brandColorHex String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects       Project[]
  licenses       License[]
  memberships    Membership[]
  shareEvents    ShareEvent[]
  subscriptions  Subscription[]
  payments       Payment[]
}

// ── Projects ─────────────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  organizationId String
  clientName     String
  inputs         String // serialized CalculatorInputs (JSON)
  results        String // serialized ScenarioResult x3 (JSON)
  recommendation String   // 'build' | 'consider' | 'dont_build'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      Report[]
  shares       Share[]

  @@index([organizationId])
}

model Report {
  id         String   @id @default(cuid())
  projectId  String
  reportType String // 'client_report' | 'proposal'
  pdfUrl     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  shares Share[]

  @@index([projectId])
}

// ── Sharing & Client Engagement ──────────────────────────────────

model Share {
  id            String    @id @default(cuid())
  shareId       String    @unique // opaque random identifier used in /r/[shareId]
  projectId     String
  reportId      String?   // optional: link to a specific generated report
  decisionState String    @default("sent") // 'sent' | 'viewed' | 'approved' | 'changes_requested'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime? // optional expiry
  revokedAt     DateTime? // set when access is revoked

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approvals  ShareApproval[]
  events     ShareEvent[]

  @@index([shareId])
  @@index([projectId])
}

model ShareApproval {
  id        String   @id @default(cuid())
  shareId   String
  action    String   // 'approve' | 'request_changes'
  name      String?
  email     String?
  comment   String?
  createdAt DateTime @default(now())

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId])
}

model ShareEvent {
  id             String   @id @default(cuid())
  shareId        String
  organizationId String
  eventType      String   // 'view' | 'section_scroll' | 'time_on_page' | 'approval'
  section        String?  // which section was viewed/scrolled
  value          Float?   // scroll depth (0-1), time in seconds, etc.
  metadata       String?  // JSON for extra data
  createdAt      DateTime @default(now())

  share        Share        @relation(fields: [shareId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([organizationId])
  @@index([createdAt])
}

// ── Licensing ────────────────────────────────────────────────────

model License {
  id             String    @id @default(cuid())
  organizationId String
  tier           String    // 'free' | 'pro' | 'agency' | 'agency_pro'
  whopOrderId    String?
  whopEventId    String?   // idempotency key from Whop webhook event
  purchasedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@unique([whopEventId])
}


// ── Billing / Subscription truth ─────────────────────────────────
// Subscription is the source of truth for an organization's current
// billing lifecycle (status, period, tier). License.tier becomes a
// derived cache that is upserted whenever Subscription.tier changes;
// it is no longer written to directly from raw webhook fields.

model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String
  // Whop membership.id — durable identifier for the customer's
  // membership lifecycle. Nullable so a subscription can exist briefly
  // before the webhook that carries the membership id arrives.
  whopMembershipId   String?   @unique
  // Internal plan key, e.g. "pro_monthly". Distinct from the raw
  // Whop plan id (see PlanMapping).
  planKey            String
  // 'free' | 'pro' | 'agency' | 'agency_pro' — derived via PlanMapping.
  tier               String
  // Mirrors Whop MembershipStatus:
  // trialing|active|past_due|completed|canceled|expired|unresolved|drafted|canceling
  status             String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
  @@index([status])
}

model Payment {
  id               String    @id @default(cuid())
  organizationId   String
  // Optional link to the Subscription row. Nullable on purpose: a
  // payment event may arrive before the corresponding membership event
  // has been processed.
  subscriptionId   String?
  // Whop payment.id (pay_...) — for billing visibility only, never
  // used to derive tier.
  whopPaymentId    String    @unique
  // webhook envelope id — the primary idempotency key.
  whopEventId      String    @unique
  amount           Decimal
  currency         String
  status           String    // 'succeeded' | 'failed' | 'pending'
  whopProductId    String?
  whopPlanId       String?
  refundedAmount   Decimal?  @default(0)
  refundedAt       DateTime?
  // Sanitized JSON snapshot of the relevant webhook payload (no PII
  // beyond what is needed for billing visibility).
  metadata         String?
  createdAt        DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
  @@index([whopEventId])
}

// ── Plan / Product mapping ────────────────────────────────────────
// Maps Whop's durable plan id (plan_...) to Viableo's internal tier
// string. A data table — not a code constant — so pricing/plan renames
// in Whop's dashboard do not require a code deploy.

model PlanMapping {
  id             String   @id @default(cuid())
  whopPlanId     String   @unique
  whopProductId  String?
  tier           String   // 'free' | 'pro' | 'agency' | 'agency_pro'
  billingPeriod  String?  // 'monthly' | 'annual'
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Observability (Agent 2 — added in migration 4) ──────────────
// Two-table separation per Viableo Production Architecture §9.1:
//   - SystemEvent = software behavior telemetry (auto-generated by
//     code paths, dashboarded, may be pruned/aggregated over time).
//   - AuditLog = privileged human/admin accountability trail (manually
//     generated by Superadmin actions, append-only, stronger
//     retention, defensible after the fact e.g. if a customer disputes
//     a tier change).
// String IDs (not Prisma relations) so high-volume operational logging
// is never blocked by a missing/cascading FK — per Agent 2 master
// prompt §4. This is the deliberate seam that makes these models safe
// to add AFTER Agent 1's billing tables without touching them.

model SystemEvent {
  id             String   @id @default(cuid())
  eventType      String
  organizationId String?
  userId         String?
  severity       String   @default("info") // 'info' | 'warn' | 'error'
  metadata       String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([organizationId])
  @@index([createdAt])
  @@index([severity])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actorRole    String   // 'SUPERADMIN' | 'OWNER' | 'MEMBER' at time of action
  action       String   // 'ENTITLEMENT_OVERRIDE' | 'IMPERSONATION_START' | 'IMPERSONATION_END' | 'BOOTSTRAP_SUPERADMIN' | 'QA_TIER_SWITCH' | ...
  targetType   String?  // 'Organization' | 'User' | 'Subscription' | ...
  targetId     String?
  reason       String?  // required for privileged actions
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
