# ── Vercel deployment hygiene (added by audit) ──────────────────────
# Local environment (never commit — use Vercel project settings for prod)
.env
.env.local
.env.*.local
!.env.example

# Local SQLite dev database
db/custom.db
db/*.db
db/*.db-journal

# Process / runtime artifacts
.zscripts/*.pid
.zscripts/*.log
*.pid

# Vercel
.vercel

# ── Sandbox / non-product files (Phase 8 cleanup — F-8) ───────────────
# NOTE: the `upload/` rule below is anchored to the repo ROOT with a leading
# slash so it ONLY ignores the top-level mandate-uploads directory
# (/home/z/my-project/upload/). Without the leading slash, `upload/` matched
# ANY directory named upload/ — including src/app/api/upload/ (the logo-upload
# API route), which silently dropped that route from the commit. Do not remove
# the leading slash.
.zscripts/
agent-ctx/
download/
/upload/
tool-results/
tmp-shadow.db*
postinstall.log
*.local
